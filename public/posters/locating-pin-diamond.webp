<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 380" width="600" height="380">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#101820" />
      <stop offset="100%" stop-color="#19252F" />
    </linearGradient>
    <pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse">
      <path d="M 24 0 L 0 0 0 24" fill="none" stroke="#263640" stroke-width="0.75" />
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="600" height="380" fill="url(#bgGrad)" />
  <rect width="600" height="380" fill="url(#grid)" />

  <!-- Technical border frame -->
  <rect x="14" y="14" width="572" height="352" fill="none" stroke="#263640" stroke-width="1.5" />
  <circle cx="20" cy="20" r="2.5" fill="#E5A34B" />
  <circle cx="580" cy="20" r="2.5" fill="#E5A34B" />
  <circle cx="20" cy="360" r="2.5" fill="#E5A34B" />
  <circle cx="580" cy="360" r="2.5" fill="#E5A34B" />

  <!-- Schematics -->
  <g>
    
      <rect x="230" y="70" width="140" height="35" rx="3" fill="none" stroke="#405160" stroke-width="2" />
      <rect x="260" y="105" width="80" height="150" fill="rgba(167,115,68,0.25)" stroke="#E5A34B" stroke-width="2.5" />
      <polygon points="260,255 340,255 320,290 280,290" fill="none" stroke="#E5A34B" stroke-width="2.5" />
      <line x1="300" y1="50" x2="300" y2="310" stroke="#405160" stroke-width="1" stroke-dasharray="6,4" />
      <circle cx="300" cy="180" r="16" fill="none" stroke="#405160" stroke-width="1.5" />
    
  </g>

  <!-- Top Left Category & ID Header -->
  <rect x="28" y="26" width="70" height="20" rx="3" fill="rgba(167,115,68,0.25)" stroke="#D99A61" stroke-width="1" />
  <text x="63" y="40" font-family="'IBM Plex Mono', Consolas, monospace" font-size="10" font-weight="bold" fill="#D99A61" text-anchor="middle">JIG-FIXTURE</text>
  <text x="108" y="40" font-family="'IBM Plex Mono', Consolas, monospace" font-size="11" fill="#A8B7BE">#locating-pin-diamond</text>

  <!-- Bottom Info Banner -->
  <rect x="28" y="318" width="544" height="36" rx="3" fill="#19252F" stroke="#405160" stroke-width="1" />
  <text x="42" y="340" font-family="'IBM Plex Sans', sans-serif" font-size="13" font-weight="600" fill="#E9EFF2">Locating Pin (Diamond / Relieved Shape)</text>
  <text x="558" y="340" font-family="'IBM Plex Mono', Consolas, monospace" font-size="10" fill="#E5A34B" text-anchor="end">CAD 3D MODEL</text>
</svg>